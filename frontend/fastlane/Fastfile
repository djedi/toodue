default_platform(:ios)

APP_ROOT = File.expand_path("..", __dir__)
IOS_PROJECT = File.join(APP_ROOT, "ios", "App", "App.xcodeproj")
ANDROID_DIR = File.join(APP_ROOT, "android")
BUILD_DIR = File.join(APP_ROOT, "build")
PACKAGE_NAME = "com.toodue.toodue"
IPA_PATH = File.join(BUILD_DIR, "ios", "TooDue.ipa")

# App Store Connect API key from fastlane/.env (see .env.example).
def asc_api_key
  key_id = ENV["ASC_KEY_ID"]
  issuer_id = ENV["ASC_ISSUER_ID"]
  key_path = File.expand_path(ENV["ASC_KEY_PATH"].to_s)
  if key_id.to_s.empty? || issuer_id.to_s.empty? || !File.file?(key_path)
    UI.user_error!("Set ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_PATH in fastlane/.env")
  end
  app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: key_path)
end

# Google Play service-account JSON key from fastlane/.env (see .env.example).
def play_json_key
  path = File.expand_path(ENV["PLAY_JSON_KEY_PATH"].to_s)
  UI.user_error!("Set PLAY_JSON_KEY_PATH in fastlane/.env to a Play Console service-account key") unless File.file?(path)
  path
end

# The production API base from .env.native. Passed explicitly so a developer's
# .env.native.local (e.g. a localhost backend) can never leak into a release.
def release_api_base
  line = File.readlines(File.join(APP_ROOT, ".env.native")).find { |l| l.start_with?("VITE_API_BASE=") }
  UI.user_error!("VITE_API_BASE missing from .env.native") unless line
  line.split("=", 2).last.strip
end

# Marketing version lives in package.json so iOS and Android never drift.
def app_version
  require "json"
  JSON.parse(File.read(File.join(APP_ROOT, "package.json"))).fetch("version")
end

def build_web_and_sync
  Dir.chdir(APP_ROOT) do
    sh("env -u CAP_DEV_HTTP VITE_API_BASE=#{release_api_base.shellescape} npm run build:native")
  end
end

def screenshots_present?
  Dir.glob(File.join(__dir__, "screenshots", "*", "*.png")).any?
end

platform :ios do
  private_lane :archive do |options|
    api_key = options.fetch(:api_key)
    build_web_and_sync

    increment_version_number(xcodeproj: IOS_PROJECT, version_number: app_version)
    build_number = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    increment_build_number(xcodeproj: IOS_PROJECT, build_number: build_number)

    key_path = File.expand_path(ENV["ASC_KEY_PATH"])
    # The IPA export shells out to rsync and only works with Apple's
    # /usr/bin/rsync; a Homebrew rsync earlier on PATH fails with "Copy failed".
    ENV["PATH"] = "/usr/bin:/bin:/usr/sbin:/sbin:#{ENV.fetch('PATH', '')}"
    build_app(
      project: IOS_PROJECT,
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.dirname(IPA_PATH),
      output_name: File.basename(IPA_PATH),
      clean: true,
      # xcpretty is a Ruby gem; with /usr/bin first it'd run under the system Ruby.
      xcodebuild_formatter: "",
      # Automatic signing; Xcode creates/refreshes the profiles via the API key.
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path.shellescape}",
        "-authenticationKeyID #{ENV['ASC_KEY_ID']}",
        "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
      ].join(" ")
    )
  end

  desc "Build the web app, archive a signed release and upload it to TestFlight"
  lane :beta do
    api_key = asc_api_key
    archive(api_key: api_key)
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Push fastlane/metadata and fastlane/screenshots to App Store Connect (no build, no submit)"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_version: app_version,
      skip_binary_upload: true,
      skip_screenshots: !screenshots_present?,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Build, upload, push metadata and submit the package.json version for App Review"
  lane :release do
    api_key = asc_api_key
    archive(api_key: api_key)
    deliver(
      api_key: api_key,
      app_version: app_version,
      ipa: IPA_PATH,
      skip_screenshots: !screenshots_present?,
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end

platform :android do
  # Next versionCode: one past the highest on any Play track. Before the app
  # exists on Play (no key yet) fall back to ANDROID_VERSION_CODE or 1.
  def next_version_code
    return ENV["ANDROID_VERSION_CODE"].to_i if ENV["ANDROID_VERSION_CODE"]
    return 1 unless File.file?(File.expand_path(ENV["PLAY_JSON_KEY_PATH"].to_s))
    codes = %w[internal alpha beta production].flat_map do |track|
      google_play_track_version_codes(json_key: play_json_key, package_name: PACKAGE_NAME, track: track)
    rescue StandardError
      []
    end
    (codes.map(&:to_i).max || 0) + 1
  end

  # Capacitor 8 needs JDK 21+; prefer Android Studio's bundled JBR over an
  # older system JDK when JAVA_HOME isn't set to something new enough.
  def ensure_modern_jdk
    jbr = "/Applications/Android Studio.app/Contents/jbr/Contents/Home"
    current = ENV["JAVA_HOME"].to_s
    version = current.empty? ? 0 : `"#{current}/bin/java" -version 2>&1`[/version "(\d+)/, 1].to_i
    ENV["JAVA_HOME"] = jbr if version < 21 && File.directory?(jbr)
  end

  private_lane :bundle do
    ensure_modern_jdk
    %w[TOODUE_UPLOAD_STORE_FILE TOODUE_UPLOAD_STORE_PASSWORD TOODUE_UPLOAD_KEY_ALIAS TOODUE_UPLOAD_KEY_PASSWORD].each do |k|
      UI.user_error!("Set #{k} in fastlane/.env (see .env.example)") if ENV[k].to_s.empty?
    end
    build_web_and_sync
    version_code = next_version_code
    UI.message("Building #{app_version} (#{version_code})")
    gradle(
      project_dir: ANDROID_DIR,
      tasks: ["clean", "bundleRelease"],
      properties: { "toodueVersionCode" => version_code, "toodueVersionName" => app_version }
    )
    lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
  end

  desc "Build a signed release AAB locally (no upload)"
  lane :build do
    UI.success("AAB: #{bundle}")
  end

  desc "Build a signed AAB and upload it to the Play internal testing track"
  lane :internal do
    upload_to_play_store(
      json_key: play_json_key,
      package_name: PACKAGE_NAME,
      track: "internal",
      aab: bundle,
      # New apps are drafts until Google approves the first release.
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote the latest internal build to production (ROLLOUT=0.2 for a staged rollout)"
  lane :promote do
    upload_to_play_store(
      json_key: play_json_key,
      package_name: PACKAGE_NAME,
      track: "internal",
      track_promote_to: "production",
      rollout: ENV["ROLLOUT"],
      metadata_path: File.join(__dir__, "metadata", "android"),
      skip_upload_changelogs: true
    )
  end

  desc "Push the Play listing text and graphics from fastlane/metadata/android"
  lane :metadata do
    upload_to_play_store(
      json_key: play_json_key,
      package_name: PACKAGE_NAME,
      metadata_path: File.join(__dir__, "metadata", "android"),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true
    )
  end
end
