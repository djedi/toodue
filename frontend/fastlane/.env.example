# Copy to fastlane/.env (gitignored).

# App Store Connect API key (TestFlight + App Store).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/AuthKey_<key id>.p8

# Google Play service-account JSON key (Play Console > Users and permissions).
PLAY_JSON_KEY_PATH=~/.play/toodue-play.json

# Android upload keystore (scripts/create-android-upload-key.sh creates one).
TOODUE_UPLOAD_STORE_FILE=~/.play/toodue-upload.jks
TOODUE_UPLOAD_STORE_PASSWORD=
TOODUE_UPLOAD_KEY_ALIAS=upload
TOODUE_UPLOAD_KEY_PASSWORD=
